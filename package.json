{
  "name": "fold-offline-split",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "start": "node server.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "build": "tsc --noEmit && vite build && node tools/build-sw.mjs",
    "test:browser": "python3 tests/browser.py",
    "format": "prettier --write src tests/*.ts tools/*.mjs vite.config.ts",
    "package": "npm run build && python3 tools/package.py"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "fake-indexeddb": "6.2.6",
    "fast-check": "4.10.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
